# CodePulse AI - Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets to git

# ===== DATABASE =====
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://codepulse_user:password@localhost:5432/codepulse

# SQLite (for local development only)
# DATABASE_URL=sqlite:///./codepulse.db

# ===== API SERVER =====
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ===== CELERY & REDIS =====
# Redis is used for Celery task queue (background jobs)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===== ANTHROPIC API =====
# Claude API key for code refactoring suggestions
ANTHROPIC_API_KEY=sk-xxx-your-key-here

# ===== PATH I: CAQI TEAM ANALYTICS =====
# Team score caching (in seconds) — set to 300 (5 min) for development, 3600 (1 hr) for production
TEAM_AGGREGATION_CACHE_TTL=3600

# How many days of history to keep for trend analysis (default: 90 days)
# Older data is automatically compressed into monthly summaries
TREND_HISTORY_DAYS=90

# Enable automatic compression of historical data (monthly)
# When enabled, daily data older than 30 days is compressed into monthly summary
CAQI_HISTORY_COMPRESSION=true

# Trend detection thresholds (do not change without testing)
# Improving: score change > TREND_THRESHOLD_PERCENT
# Declining: score change < -TREND_THRESHOLD_PERCENT
# Stable: within ±TREND_THRESHOLD_PERCENT
TREND_THRESHOLD_PERCENT=5

# Feature flags for Path I components
ENABLE_CAQI_AGGREGATION=true          # Enable team aggregation service
ENABLE_TREND_ANALYSIS=true            # Enable trend detection and history
ENABLE_PERSONALITY_MAPPING=true       # Enable archetype classification
ENABLE_CAQI_API_ENDPOINTS=true        # Enable /api/v1/caqi/* endpoints

# ===== LOGGING =====
LOG_LEVEL=INFO
# Set to DEBUG for verbose logging (development only)
# LOG_LEVEL=DEBUG

# ===== OPTIONAL: GitHub Integration (Phase 4) =====
# GITHUB_CLIENT_ID=xxx
# GITHUB_CLIENT_SECRET=xxx
# GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# ===== OPTIONAL: Slack Integration (Phase 4) =====
# SLACK_BOT_TOKEN=xoxb-xxx
# SLACK_SIGNING_SECRET=xxx
