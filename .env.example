# CodePulse AI Environment Configuration
# Copy this file to .env and update values for your environment

# ==========================================
# Backend Configuration
# ==========================================

# API Server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
DEBUG=false

# Database
DATABASE_URL=sqlite:///codepulse.db
# For PostgreSQL: postgresql://user:password@localhost:5432/codepulse

# Security
SECRET_KEY=your-secret-key-here-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# External Services
SENTRY_DSN=
DATADOG_API_KEY=

# ==========================================
# Frontend Configuration
# ==========================================

# API Endpoint
REACT_APP_API_URL=http://localhost:8000/api/v1

# Environment
NODE_ENV=development

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_EXPORT=true

# ==========================================
# Docker Configuration
# ==========================================

# Docker Compose
COMPOSE_PROJECT_NAME=codepulse
COMPOSE_FILE=docker-compose.yml

# ==========================================
# Monitoring & Logging
# ==========================================

# Sentry Error Tracking
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# DataDog Monitoring
DD_ENV=production
DD_SERVICE=codepulse-api
DD_VERSION=1.0.0

# ==========================================
# Email Notifications
# ==========================================

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=alerts@codepulse.company

# ==========================================
# AWS Configuration (Optional)
# ==========================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=codepulse-reports
