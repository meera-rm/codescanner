# CodePulse AI - Environment Variables

# Flask Configuration
FLASK_APP=api/main.py
FLASK_ENV=production
SECRET_KEY=your-secure-secret-key-here

# Database
DATABASE_URL=postgresql://codepulse:password@localhost:5432/codepulse
DB_POOL_SIZE=20
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4
API_TIMEOUT=120

# GitHub Integration (Phase 12)
# Register your GitHub App at: https://github.com/settings/apps
GITHUB_APP_ID=12345
GITHUB_APP_NAME=codepulse-ai
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Token Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
GITHUB_TOKEN_KEY=your_fernet_key_here

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
ENABLE_MONITORING=true
PROMETHEUS_PORT=9090

# Security
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
SESSION_TIMEOUT=3600
MAX_CONTENT_LENGTH=104857600

# Email (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Enterprise
STRIPE_API_KEY=sk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Feature Flags
ENABLE_GITHUB_INTEGRATION=true
ENABLE_CICD_INTEGRATION=true
ENABLE_GIT_HOOKS=true
ENABLE_IDE_PLUGINS=true
ENABLE_ENTERPRISE_FEATURES=true
