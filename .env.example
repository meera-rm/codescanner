# CodePulse Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# EMAIL ALERTS (Gmail, Outlook, AWS SES, or Custom SMTP)
# ============================================================================

# Gmail Setup (Recommended for testing):
# 1. Enable 2-factor authentication on your Gmail account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the app password below (16-character code)

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Alternative: Custom SMTP Server
# SMTP_SERVER=mail.your-company.com
# SMTP_PORT=587
# SMTP_USERNAME=your-username
# SMTP_PASSWORD=your-password

# ============================================================================
# SLACK WEBHOOKS
# ============================================================================

# How to get a Slack webhook:
# 1. Go to https://api.slack.com/apps
# 2. Click "Create New App" → "From scratch"
# 3. Name your app (e.g., "CodePulse Alerts")
# 4. Select your workspace
# 5. Go to "Incoming Webhooks" in the left menu
# 6. Toggle "Activate Incoming Webhooks" to ON
# 7. Click "Add New Webhook to Workspace"
# 8. Select the channel to post to
# 9. Copy the Webhook URL

# Example (do not use this!):
# SLACK_WEBHOOK_EXAMPLE=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# ============================================================================
# REDIS CACHING (Optional but recommended for performance)
# ============================================================================

# Enable Redis caching (true/false, default: true)
REDIS_ENABLED=true

# Redis server connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Redis authentication (leave empty if no password)
REDIS_PASSWORD=

# To use Redis:
# 1. Install Redis locally:
#    - macOS: brew install redis
#    - Linux: sudo apt-get install redis-server
#    - Windows: https://github.com/microsoftarchive/redis/releases
#
# 2. Start Redis server:
#    - macOS/Linux: redis-server
#    - Windows: redis-server.exe
#
# 3. Test connection: redis-cli ping
#    (Should return: PONG)
#
# To disable caching:
# Set REDIS_ENABLED=false
#
# Features provided by Redis:
# - Dashboard summary (5-minute cache)
# - Scan history (10-minute cache)
# - Trend metrics (15-minute cache)
# - Search filters (1-hour cache)
# - Autocomplete suggestions (1-hour cache)
#
# Cache is automatically invalidated when new scans complete.
#
# Monitoring:
# - View stats: curl http://localhost:8000/api/v1/cache/stats
# - Check health: curl -X POST http://localhost:8000/api/v1/cache/health
# - Clear cache: curl -X POST http://localhost:8000/api/v1/cache/clear?scope=all
